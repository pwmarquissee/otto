# Otto configuration, one line per environment variable otto/config.py reads.
#
# Every value here is optional. Unset means the default shown, and the defaults are
# the closed position: no owner, no org domains, no Slack channels, nothing to
# message anyone about. Fill in the identity block first; most of the rest can wait.
#
# Lists are comma-separated unless the comment says os.pathsep (`;` on Windows,
# `:` elsewhere), which is used for filesystem paths because paths contain commas.
# Three ways to set these, highest precedence first: the environment, the file
# <OTTO_HOME>/otto.env (what the dashboard's Setup view and `otto setup` write),
# then the defaults in otto/config.py. Keep any real copy out of git.

# ---- identity: who Otto works for, and where --------------------------------
OTTO_OWNER_NAME=Alex Example                # how prompts refer to the owner, third person (default: "the owner")
OTTO_OWNER_EMAIL=alex@example.com           # the owner's work email; "" = unconfigured, features that need it say so
OTTO_OWNER_SLACK_ID=U0000000000             # the owner's Slack user id; "" = unconfigured
OTTO_KNOWN_BOT_SLACK_IDS=B0000000000        # Slack user ids of sanctioned bots whose replies are not human resolutions
OTTO_ORG_NAME=Example Studio                # the company name, for prompts and the writing scan (default: "your organization")
OTTO_ORG_DOMAINS=example.com                # mail domains Otto may address unattended; empty = outreach refuses everyone
OTTO_CONTRACTOR_DOMAINS=ext.example.com     # mail domains that count as contractors (see OTTO_OUTREACH_CONTRACTORS)
OTTO_MEETINGS_OWNER=Alex Example            # the owner's name as colleagues write it in meeting notes (default: OTTO_OWNER_NAME)
OTTO_MEETINGS_OWNER_EMAIL=alex@example.com  # (default: OTTO_OWNER_EMAIL)
OTTO_SLACK_OWNER=alex@example.com           # who Otto reports to on Slack and adds to every group DM (default: OTTO_OWNER_EMAIL)

# ---- scope ----------------------------------------------------------------
OTTO_SCOPE=core                           # core = the orchestrator only; assistant = adds outreach, writing, people, prep, wellbeing, summon, inbox, meetings (routes, tick hooks, schedules, subcommands)
OTTO_POWERSHELL=powershell                # the PowerShell that runs per-run launchers on Windows; pwsh for PowerShell 7 (POSIX uses bash, no setting)

# ---- paths ------------------------------------------------------------------
OTTO_HOME=/home/alex/.claude/otto           # state, logs, pidfile, feed inbox; never the repo (default: ~/.claude/otto)
OTTO_PROFILE=/home/alex/.claude/otto/profile.md         # how the owner wants to be worked with (default: OTTO_HOME/profile.md)
OTTO_PRIORITIES=/home/alex/.claude/otto/priorities.md   # what matters right now, with a reviewed: date (default: OTTO_HOME/priorities.md)
OTTO_PRIORITIES_MAX_AGE=45                  # days unreviewed before priorities report STALE
OTTO_WORK_ROOTS=/home/alex/work;/home/alex/it-repos      # os.pathsep-separated dirs scanned for work projects (default: none)
OTTO_PERSONAL_ROOTS=/home/alex/personal     # os.pathsep-separated dirs scanned for personal projects (default: none)
OTTO_BACKUP_PATHS=/home/alex/personal/photos             # os.pathsep-separated; newest mtime answers "when did this last back up"
OTTO_FEED_DIR=/home/alex/.claude/otto/feed  # producer inbox (default: OTTO_HOME/feed)
OTTO_PRODUCERS_DIR=/path/to/otto/producers  # where producer scripts live, in the repo (default: <repo>/producers)
OTTO_SLACK_SPOOL=/home/alex/.claude/otto/slack-spool    # slack_dm_producer spool (default: OTTO_HOME/slack-spool)
OTTO_CHAT_CWD=/home/alex                    # a workspace Claude Code already trusts (default: home)
OTTO_TASK_CWD=/home/alex                    # default cwd for dispatched tasks (default: home)
OTTO_WRITING_VOICE=/home/alex/.claude/otto/writing-voice.md      # (default: OTTO_HOME/writing-voice.md)
OTTO_WRITING_SAMPLES=/home/alex/.claude/otto/writing-samples.md  # (default: OTTO_HOME/writing-samples.md)

# ---- daemon -----------------------------------------------------------------
OTTO_HOST=127.0.0.1                         # bind address
OTTO_PORT=8787                              # bind port
OTTO_URL=http://127.0.0.1:8787              # what clients call (default: built from host and port)
OTTO_ALLOWED_ORIGINS=                       # extra browser origins allowed to call the daemon, comma-separated, e.g. http://localhost:9000 for a forwarded port; added to the loopback origins on OTTO_PORT (see SECURITY.md)
OTTO_ALLOWED_HOSTS=                         # extra Host header names accepted, comma-separated; added to 127.0.0.1, localhost, ::1 (the DNS rebinding check)
OTTO_TICK=15                                # seconds between daemon ticks
OTTO_NO_TOAST=0                             # 1 = never raise an OS notification; every test harness sets this
OTTO_STATE_IDLE_CACHE=10                    # seconds a quiet store may serve the same /api/state bytes; any write invalidates at once
OTTO_STATE_DETAIL_CHARS=600                 # task detail in /api/state is cut here and flagged detail_truncated; GET /api/tasks/{id} has it all
OTTO_STATE_RUNS=80                          # runs carried in /api/state (the dashboard draws every one it gets)
OTTO_STATE_EVENTS=60                        # events carried in /api/state
OTTO_WS_EVENTS_POLL=0.25                    # seconds between store.version checks on /ws/events
OTTO_WS_EVENTS_PING=25                      # seconds between keepalive pings on an idle /ws/events socket

# ---- AWS --------------------------------------------------------------------
OTTO_AWS_PROFILE=default                    # the SSO profile Otto probes to answer "is my session live"

# ---- integrations -----------------------------------------------------------
OTTO_INTEGRATIONS=aws,notion                # which probes run: any of anthropic,aws,notion,herdr; "none" or unset = no probes, nothing leaves the box (otto setup writes this)

# ---- sessions (Claude Code hooks) -------------------------------------------
OTTO_SESSION_WAITING_MIN=15                 # minutes blocked on a permission prompt before it is an alert
OTTO_SESSION_BUSY_HOURS=2                   # hours busy without a Stop before it is flagged (informational)
OTTO_SESSION_OFFLINE_HOURS=12               # hours of silence before a session is presumed gone
OTTO_SESSION_PRUNE_DAYS=7                   # days an offline session stays listed
OTTO_SESSION_WAITING_TOAST=1                # 0 = no immediate toast when a session starts waiting

# ---- herdr (terminal harness) -----------------------------------------------
OTTO_HERDR_BIN=/usr/local/bin/herdr         # path to the herdr binary; "" = herdr integration off
OTTO_HERDR_SYNC=1                           # sync herdr's agent view into session rows
OTTO_HERDR_CLAUDE_ARGS=--dangerously-skip-permissions   # args claude starts with inside a pane; "" = permission prompts
OTTO_HERDR_START_TIMEOUT=90                 # seconds to wait for a fresh claude prompt in a pane
OTTO_HERDR_POLL=2                           # seconds between snapshot polls
OTTO_HERDR_RUNS=1                           # run Otto's own jobs inside panes when the server is up
OTTO_HERDR_RUNS_KEEP_MINUTES=60             # minutes a finished run's pane stays for scrollback
OTTO_HERDR_AUTOSTART=1                      # start the herdr server with the daemon
OTTO_HERDR_WINDOW_TITLE=1                   # name the herdr window with idle/working/blocked counts

# ---- logistics dispatch -----------------------------------------------------
OTTO_LOGISTICS_MAX=3                        # proposals shown at once
OTTO_LOGISTICS_MIN_CONF=0.35                # floor below which a pairing is not proposed
OTTO_LOGISTICS_SETTLE=45                    # seconds to ignore "idle" after a hand-off

# ---- models and budgets -----------------------------------------------------
OTTO_DEFAULT_MODEL=opus[1m]                 # passed as --model on every spawn
OTTO_DEEP_TAG=deep                          # card tag that selects the deep model
OTTO_DEEP_MODEL=claude-fable-5              # the opt-in heavy model
OTTO_DEEP_BUDGET_USD=15                     # per-run ceiling for deep runs
OTTO_MCP_FREE=                              # slash commands that need no MCP server at all (see config.py before adding one)
OTTO_THREAD_NOTE_CONCURRENT=3               # thread-note sessions in flight at once
OTTO_THREAD_NOTE_THROTTLE=5                 # seconds between thread-note spawns
OTTO_THREAD_NOTE_MODEL=claude-haiku-4-5-20251001
OTTO_THREAD_NOTE_BUDGET=0.35                # per-note ceiling; must exceed the session floor cost
OTTO_CHAT_MODEL=                            # "" = OTTO_DEFAULT_MODEL
OTTO_REFRESH_MODEL=claude-haiku-4-5         # calendar/mail refresher; "" = OTTO_DEFAULT_MODEL
OTTO_MEETINGS_MODEL=claude-sonnet-5         # meeting-notes extractor; "" = OTTO_DEFAULT_MODEL
OTTO_MEETINGS_BUDGET_USD=1.5
OTTO_WRITING_MODEL=claude-sonnet-5          # post drafts; "" = OTTO_DEFAULT_MODEL
OTTO_WRITING_BUDGET_USD=1.0
OTTO_SUMMON_MODEL=claude-sonnet-5
OTTO_SUMMON_BUDGET=1.0
OTTO_DM_MODEL=claude-sonnet-5
OTTO_DM_BUDGET=0.75
OTTO_CARD_REPLY_MODEL=claude-sonnet-5       # (default: OTTO_DM_MODEL)
OTTO_CARD_REPLY_BUDGET=0.75                 # (default: OTTO_DM_BUDGET)
OTTO_OUTREACH_MODEL=claude-haiku-4-5-20251001   # fallback sender when the bot credential is unavailable
OTTO_OUTREACH_BUDGET=0.75
OTTO_OUTREACH_SEND_TIMEOUT=120              # seconds before a send is recorded as UNKNOWN

# ---- Slack --------------------------------------------------------------------
OTTO_SLACK_CHANNEL=ops-feed                 # name of the owner's one-way ops feed, for display (default: none)
OTTO_SLACK_CHANNEL_ID=C0000000000           # its id; empty = every top-level post refused
OTTO_SLACK_BOT_CRED=otto-dm-sweep-bot-token # name of the bot token in the just-in-time credential store
OTTO_REPLY_CHANNELS=C0000000000             # channels Otto may reply inside an existing thread; empty = none
OTTO_POST_CHANNELS=C0000000000              # channels Otto may post top-level (default: OTTO_SLACK_CHANNEL_ID only)
OTTO_HELP_CHANNEL=C0000000000               # the internal support channel the summon watcher reads; empty = idle
OTTO_SUMMON_PROMPT=/help-triage              # the slash command a summon dispatches; empty = watcher idle
OTTO_SUMMON_EMOJI=otto-help                 # the reaction that summons Otto into a thread
OTTO_SUMMON_POLL=1                          # 0 = summons only noticed by the periodic sweep
OTTO_SUMMON_SCAN=40                         # messages examined per poll
OTTO_SUMMON_EVERY=60                        # seconds between polls
OTTO_DM_POLL=1                              # read Otto's own DM for instructions from the owner
OTTO_DM_EVERY=30                            # seconds between DM checks

# ---- outreach (Otto messaging colleagues) -----------------------------------
OTTO_OUTREACH=0                             # master switch; 0 = compose, hold, EXPIRE, never transmit
OTTO_OUTREACH_HOLD=10                       # minutes the owner has to kill a held message
OTTO_OUTREACH_MAX_DAY=6                     # messages per rolling 24h
OTTO_OUTREACH_MAX_PERSON=2                  # messages to any one person per rolling 24h
OTTO_DIRECTED_MAX_PER_RUN=2                 # directed DMs to one recipient per run
OTTO_OUTREACH_CONTRACTORS=0                 # 1 = people on OTTO_CONTRACTOR_DOMAINS may be addressed
OTTO_OUTREACH_CHANNELS=                     # channels Otto may post to unattended; empty = DMs only
OTTO_OUTREACH_GROUP_DM=1                    # group DM with the owner rather than a private 1:1

# ---- meeting notes ingest -----------------------------------------------------
OTTO_MEETINGS_FIRST_RUN_DAYS=7              # lookback when there is no watermark yet
OTTO_MEETINGS_MAX=8                         # cards filed per run
OTTO_MEETINGS_DUE_SOON_DAYS=3               # due within this raises a notice
OTTO_MEETINGS_SEEN_LIMIT=400                # page ids remembered
OTTO_MEETINGS_AUTOQUEUE=0                   # keep OFF: extracted items would dispatch unattended sessions

# ---- nudges, due dates, milestones ------------------------------------------
OTTO_NUDGE_THREAD_DAYS=7                    # a dated dossier thread quiet this long is mentioned
OTTO_NUDGE_THREAD_MAX=30                    # older than this is archaeology, not a nudge
OTTO_NUDGE_THREAD_EVERY=7                   # thread review cadence in days
OTTO_MILESTONES=Trade show (partner meetings)|2026-08-25|work;Family trip|2026-12-20|personal   # label|YYYY-MM-DD|domain, `;` separated
OTTO_MILESTONE_HORIZON=30                   # days out to start counting down
OTTO_DUE_SOON_DAYS=1
OTTO_DUE_RENAG_DAYS=7                       # how often an overdue card is asked about again
OTTO_DUE_TOASTS_PER_DAY=3                   # most pressing N get a toast; the rest go in the digest
OTTO_REPLY_SCHEME=auto                      # auto | otto | http: where a toast's Reply lands

# ---- quiet hours and notices --------------------------------------------------
OTTO_QUIET_FROM=22                          # local hour, inclusive, toasts are held from
OTTO_QUIET_TO=7                             # local hour, exclusive, toasts resume
OTTO_NOTICE_DEDUPE_HOURS=20                 # how long the same subject stays deduped

# ---- calendar and meeting prep ----------------------------------------------
OTTO_CALENDAR_BLOCKS=\bstand-?ups?\b|\bwork time\b|\breclaim\b   # `|`-separated regexes for non-meeting blocks (default list in config.py)
OTTO_PREP_LEAD=15                           # minutes before a meeting the prep notice fires
OTTO_PREP_NOTIFY=1                          # 0 = prep brief lands in the dashboard only
OTTO_PREP_MAX_PEOPLE=3                      # full dossiers before the brief collapses to a roster

# ---- writing (public posts) -------------------------------------------------
OTTO_WRITING_IDEAS_MAX=5
OTTO_WRITING_LOOKBACK_DAYS=7
OTTO_WRITING_CODENAMES=Project Nightjar,M5,Atlas   # internal names that must never appear in a public post (default: none)
OTTO_WRITING_VENDORS=Okta,CrowdStrike,NinjaOne     # vendors in your stack; naming one is flagged as a decision
OTTO_WRITING_PERSONAL=Sam,Riley            # family and personal names; flagged, not blocked
OTTO_WRITING_EMPLOYER=Example Studio,Example Studio Inc   # (default: OTTO_ORG_NAME)

# ---- findings, triage, board --------------------------------------------------
OTTO_FINDINGS_MAX=5                         # cards one run may file
OTTO_FINDINGS_MAX_PER_DAY=12                # cards all runs may file per UTC day; overflow goes to DEBT.md
OTTO_TRIAGE_MAX_IN_FLIGHT=3                 # queued+running before triage stops promoting
OTTO_TRIAGE_STALE_DAYS=10                   # backlog age that triggers a "did this already happen" check
OTTO_FADE_DAYS=14                           # untouched owner cards leave the columns after this
OTTO_BOARD_DONE_DAYS=7                      # finished cards stay on the board this long (0 = forever)
OTTO_DEDUPE_SIMILARITY=0.55                 # Jaccard threshold for same-card detection
OTTO_DEDUPE_MIN_SHARED=3                    # minimum shared content tokens
OTTO_RETIRE_CARD_DAYS=30
OTTO_RETIRE_NAG_SEEN=4
OTTO_RETIRE_MISSING_DAYS=14
OTTO_RETIRE_NEVER_DAYS=16

# ---- auto-dispatch and unattended runs --------------------------------------
OTTO_AUTODISPATCH=1                         # 0 = `queued` becomes inert
OTTO_TASK_CONCURRENCY=2
OTTO_TASK_ATTEMPTS=1                        # >1 enables automatic retries
OTTO_TASK_THROTTLE=20                       # seconds between dispatches
OTTO_TASK_BUDGET_USD=5                      # per-task ceiling; 0 disables
OTTO_AUTORUN=1                              # 0 = every schedule is report-only
OTTO_AUTORUN_CONCURRENCY=1
OTTO_AUTORUN_MAX_FAILURES=3                 # consecutive failures before a schedule disables itself
OTTO_AUTORUN_MIN_GAP=30                     # minutes between autoruns of the same schedule
OTTO_AUTORUN_BUDGET_USD=25                  # per-run ceiling; 0 disables

# ---- feeds --------------------------------------------------------------------
OTTO_FEED_MAX_BYTES=262144                  # largest feed file the daemon will read
OTTO_FEED_MAX_ITEMS=10                      # items kept per feed

# ---- capability manifest and agent identity ---------------------------------
OTTO_CAPABILITIES=code-mcp/idp,desktop-mcp/rmm,!code-mcp/old-edr=subscription lapsed   # surface/name, `!` = expected absent, `=reason`
OTTO_INHERITED_BASELINE=0                   # accepted count of integrations that authenticate as the owner (see config.PRINCIPALS)

# ---- first run -----------------------------------------------------------------
OTTO_ARM_DEFAULT_SCHEDULES=0                # 1 = the seeded read-only schedules (refresh, meeting notes, writing ideas) start running on the first tick; 0 = they wait for `otto schedule arm <name>`

# ---- credentials and production write signals -------------------------------
OTTO_CREDENTIAL_RUN=mycred run --with {env}={cred} --   # command prefix that hands a secret to a short-lived child; empty = Slack sends refused
OTTO_WRITING_HOST_PATTERN=                  # regex for your hostnames so a machine name never leaves in a draft; empty = default shape
OTTO_PROD_WRITE_SIGNALS=rmm=^mcp__rmm__.*(reboot|run_script);idp=^mcp__idp__.*(create|update|delete)   # label=regex;... tool names that write to production

# ---- the guard hook (scripts/otto_guard.py), all gates closed when empty -----
OTTO_GUARD_CRED_COMMANDS=mycred,anthropic-env   # commands whose invocation means a credential checkout; gated unattended
OTTO_GUARD_CRED_FILES=.anthropic-env.cache      # files whose read means a credential checkout
OTTO_GUARD_IDP_TOOL_PATTERN=idp                 # case-insensitive regex over MCP tool names that mutate your identity provider
OTTO_GUARD_ASK=1                                # raise a desktop yes/no dialog for gated actions (0 = deny silently)
OTTO_GUARD_ASK_TIMEOUT=120                      # seconds the dialog waits before it counts as declined

# ---- Slack DM producer (producers/slack_dm_producer.py) ---------------------
OTTO_SLACK_BOT_TOKEN=                       # user token (xoxp-) with im:history for the owner's DMs; prefer the credential CLI
OTTO_SLACK_BOOTSTRAP_HOURS=72               # how far back the first sweep reads
OTTO_SLACK_COLD_AFTER=14                    # days of silence before a conversation is cold
OTTO_SLACK_COLD_EVERY=6                     # hours between cold-conversation checks
OTTO_SLACK_MAX_PER_CONVO=200                # messages read per conversation per sweep
OTTO_SLACK_PAUSE_HISTORY=0.3                # seconds between history calls
OTTO_SLACK_PAUSE_LIST=0.5                   # seconds between list calls
OTTO_SLACK_SPOOL_RETAIN_HOURS=168           # how long spool records are kept
OTTO_NO_SEND=0                              # 1 = every Slack send is logged and dropped (dry run)

# ---- developer switches ------------------------------------------------------
OTTO_HOOK_DEBUG=                            # path of a file the session hook appends breadcrumbs to
OTTO_REPO=                                  # the checkout the desktop shell points at; default is the directory it runs from

# Set BY Otto on the processes it spawns, never by you: OTTO_RUN_ID, OTTO_RUN_NAME, OTTO_UNATTENDED.
