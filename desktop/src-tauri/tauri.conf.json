{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otto",
  "version": "0.1.0",
  "identifier": "dev.otto.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["otto"]
      }
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Otto",
    "longDescription": "Otto's dashboard in a window, with a tray icon that shows whether the floors are holding."
  }
}
